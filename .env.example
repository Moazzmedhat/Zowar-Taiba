# Supabase Configuration
# Obtain these from your Supabase Dashboard: Settings -> API

# Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key (Recommended for Vercel Serverless Functions)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Anon Public Key (Fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Storage Bucket name for generated PDFs (defaults to trip-pdfs)
SUPABASE_STORAGE_BUCKET=trip-pdfs
